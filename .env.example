# 환경변수 "이름"만 적은 예시입니다. 실제 값은 이 파일이 아니라 Vercel > Project > Settings > Environment Variables
# (Production / Preview 각각)에만 등록하세요. 값을 Git·채팅·스크린샷·로그에 남기지 않습니다.
# 이 파일을 .env 로 복사해 값을 채우는 경우에도 .env 는 .gitignore 로 제외돼 있습니다.

# --- Supabase (기존 /api/discounts 와 같은 변수) -------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # 서버 전용. 브라우저 코드(app.html)에는 절대 넣지 않는다.

# --- 쿠팡 파트너스 Open API (판매자용 Wing API 와 다른 키) -----------------------------------
# 파트너스 포털에서 발급. 서버 전용.
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=

# --- 쿠팡 API 확인·갱신 기능 (api/coupang-refresh.js) ----------------------------------------
# 1단계(기본 꺼짐): true 로 바꾸면 "확인만" 한다 — 쿠팡을 호출해 상품·옵션이 일치하는지 보고 상태만 기록하며, 가격·이미지는 저장하지 않는다.
COUPANG_REFRESH_ENABLED=false
# 2단계(기본 꺼짐): 가격·이미지를 실제로 저장한다. 실제 응답에서 상품·옵션 식별자와 가격이 같은 옵션의 것임을
# tools/verify-coupang.mjs 로 확인한 뒤에만 true. 확인하지 못했다면 켜지 않는다.
COUPANG_PRICE_REFRESH_ENABLED=false
# 선택. 검색 경로 형태: 비우면 .../openapi/products/search, 아래 값이면 .../openapi/v1/products/search (두 가지만 허용).
# 공식 문서에서 확인한 형태에 맞춰 고른다.
COUPANG_PARTNERS_SEARCH_PATH=
# 쉼표로 구분한 관리자 이메일(소문자 비교). 이 계정의 로그인 토큰이 있어야 갱신 API 가 동작한다.
ADMIN_EMAILS=
# 선택. 시간당 검색 호출 예산(1~10, 기본 8). 공개 정리글 기준 한도는 시간당 10회라 여유를 둔다.
COUPANG_SEARCH_HOURLY_BUDGET=8
# 선택. 한 번 실행에 처리할 상품 수(1~8, 기본 3). 상품 1개 = 검색 호출 1회.
COUPANG_REFRESH_MAX_PER_RUN=3
